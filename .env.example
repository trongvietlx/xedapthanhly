# Resend API key used to send admin notification emails on new bookings
# https://resend.com/api-keys
RESEND_API_KEY=

# Email address that receives new order notifications
ADMIN_NOTIFICATION_EMAIL=sale@xedapthanhly.vn

# Verified sender address in Resend (must be a verified domain in production)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Analytics 4 Measurement ID (Admin > Data Streams > your stream)
# Format: G-XXXXXXXXXX. Public (exposed to the browser via NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_GA_ID=

# Facebook Pixel ID (Events Manager > your pixel > Settings)
# Public (exposed to the browser via NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_FB_PIXEL_ID=

# Telegram Bot notification for new bookings.
# 1. Chat @BotFather on Telegram, run /newbot, copy the token it gives you.
# 2. Add your bot to the group/channel (or DM it), then call
#    https://api.telegram.org/bot<TOKEN>/getUpdates to read the chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
